# InfraEye Environment Configuration

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_AUTH_ANONYMOUS_ENABLED=false

# Alertmanager Configuration
SMTP_HOST=localhost:587
SMTP_FROM=alertmanager@example.org
SMTP_USER=
SMTP_PASS=
EMAIL_RECIPIENTS=admin@example.com

# Slack Integration
SLACK_WEBHOOK_URL=

# Telegram Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PagerDuty Integration
PAGERDUTY_SERVICE_KEY=

# Webhook for Remediation
WEBHOOK_URL=http://remediation-service:8080/webhook

# PostgreSQL Configuration
POSTGRES_DSN=postgresql://user:password@localhost:5432/database?sslmode=disable

# Reporting Service Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_RECIPIENTS=admin@example.com

# Security
GF_SECURITY_SECRET_KEY=changeme